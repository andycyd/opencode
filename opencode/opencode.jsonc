{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://host.docker.internal:1234/v1"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b (local)"
        },
        "qwen/qwen3.6-27b": {
          "name": "qwen/qwen3.6-27b (local)"
        },
        "qwen3.6-35b-a3b-mtp": {
          "name": "qwen3.6-35b-a3b-mtp (local)"
        },
        "mistralai/devstral-small-2-2512": {
          "name": "mistralai/devstral-small-2-2512 (local)"
        }
      }
    }
  },
  "lsp": {
    "csharp": {
      "command": ["roslyn-language-server", "--stdio", "--autoLoadProjects"],
      "extensions": [".cs", ".razor", ".cshtml"]
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "agent": {
    "build": {
      "disable": false
    },
    "plan": {
      "disable": false
    }
  },
  "subagent_depth": 2,
  "default_agent": "dotnet-planner"
}